<?xml version="1.0" encoding="UTF-8"?>
<!-- Termdeck thin agent — macOS launchd user agent. install.sh writes this for you;
     this template is for manual setup. Put it at:
       ~/Library/LaunchAgents/io.termdeck.agent.plist
     then:  launchctl load ~/Library/LaunchAgents/io.termdeck.agent.plist
     Fill in the node path (which node), the agent path, and this machine's token.

     The label is what the owner sees in System Settings > General > Login Items &
     Extensions, so it names Termdeck rather than a bundle id nobody recognises.

     KeepAlive is a dict, not a bare <true/>: SuccessfulExit=false means a CLEAN
     exit is respected (we meant to stop) while any crash still restarts us.
     ThrottleInterval stops an agent that dies on boot from respawning in a tight
     loop — it is launchd's own default, made explicit. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.termdeck.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/YOU/.termdeck/agent/agent.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TERMDECK_AGENT_TOKEN</key><string>agt_...</string>
    <key>TERMDECK_MASTER_URL</key><string>https://termdeck.io</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
